# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API Configuration (defaults to /api for integrated preview, or http://localhost:8080/api for Java Spring Boot)
VITE_API_BASE_URL="/api"

# Security & JWT
JWT_SECRET="CHANGE_ME_256_BIT_PRODUCTION_SECRET"
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# MySQL 8 Configuration (for Java Spring Boot backend)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DATABASE="helpdesk_pro"
MYSQL_USER="helpdesk_app"
MYSQL_PASSWORD="CHANGE_ME_DB_PASSWORD"

# AWS S3 Storage (optional; uses local development storage adapter when omitted)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="helpdesk-pro-attachments"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SMTP Email Configuration (optional; logs email dispatch in dev mode when omitted)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@helpdeskpro.enterprise"
